# ---------- Database (PostgreSQL) ----------
# The backend uses the PostgreSQL database "service-request_db".
# 1) Replace YOUR_PASSWORD (URL-encode special characters, e.g. "@" becomes "%40")
# 2) npm run db:setup   (creates the database if it does not exist, then applies the migrations)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/service-request_db?schema=public"
# For a normal PostgreSQL server DIRECT_URL is the same as DATABASE_URL. It only differs behind a connection
# pooler such as Supabase: DATABASE_URL = pooler (port 6543, add ?pgbouncer=true&connection_limit=1),
# DIRECT_URL = direct connection (port 5432, used by prisma migrate).
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/service-request_db?schema=public"

# ---------- App ----------
# Public base URL of the app (no trailing slash). Must match the Google redirect URI host.
APP_URL="http://localhost:3000"
# Random secret used to sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ---------- Google sign-in (Gmail and Google Workspace) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
# OAuth consent screen: user type "External", then "Publish app", so any Gmail account can sign in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# People with an email in these domains get an account on their first sign-in (comma separated).
# Anyone else, a Gmail address for example, can sign in once an administrator has registered their email in /admin/users.
ALLOWED_EMAIL_DOMAINS="yourcompany.com"

# ---------- Roles ----------
# Emails granted a role on first sign-in (comma separated; any domain, Gmail too). Roles can be changed later in /admin/users.
ADMIN_EMAILS=""
IT_STAFF_EMAILS=""

# ---------- SLA ----------
# Public holidays excluded from SLA business time (comma separated YYYY-MM-DD).
# Business hours are Mon-Fri 08:30-17:30 with a 12:00-13:00 break (see src/lib/sla.ts).
SLA_HOLIDAYS=""

# ---------- Cookies ----------
# Cookies are marked Secure (https only) in production. If the site is served over plain http inside a private network
# (for example http://10.0.0.5:3000), browsers drop them and nobody can sign in: put https in front (recommended), or set
# COOKIE_SECURE="false". Then cookies and passwords travel unencrypted, so use it only on a network you trust.
# COOKIE_SECURE="false"

# ---------- Local development only ----------
# Shows a "pick a seeded user" login. Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN="false"
