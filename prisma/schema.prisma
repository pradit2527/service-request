// AIDC Service Request
// PostgreSQL, database "service-request_db". DATABASE_URL and DIRECT_URL are the same for a normal server;
// behind a pooler (e.g. Supabase) DATABASE_URL = pooled connection, DIRECT_URL = direct connection for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// MANAGER: an employee who can be chosen as the approver of other people's requests.
enum Role {
  EMPLOYEE
  MANAGER
  IT_STAFF
  ADMIN
}

enum RequestType {
  AWS_SERVER
  DATABASE
  PUBLIC_IP_DOMAIN
  ACCESS_ACCOUNT
  SOFTWARE
  OTHER
  HARDWARE
  NETWORK_WORKPLACE
  CONSULTATION
  DATA_EXTRACT
  DATA_CORRECTION
  BULK_IMPORT
  REPORT_TEMPLATE
  SYSTEM_CONFIG
  DEPLOYMENT
  BACKUP_RESTORE
  TRAINING
  DOCUMENT
  ENVIRONMENT
  FIREWALL
  RESOURCE_UPGRADE
  CLOUD_RESOURCE
  API_CREDENTIAL
  SECURITY_REVIEW
  ONBOARDING
  OFFBOARDING
  SPARK_AI
  GPU_5090
  CLAUDE_AI
  GEMINI_AI
  OTHER_AI
}

enum RequestStatus {
  SUBMITTED
  IN_REVIEW
  NEED_INFO
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PENDING_APPROVAL
  ON_HOLD
}

// Service Level Agreement tier, see src/lib/sla.ts
enum SlaTier {
  STANDARD
  PROVISIONING
  HARDWARE
  COMPLEX
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EventAction {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  SLA_CHANGED
  APPROVER_CHANGED
  EDITED
  DELETED
  RESTORED
  // The approver asked the requester for more information while the request waited for approval.
  INFO_REQUESTED
  // A stand-in approver decided in place of the manager who is away (toValue is that manager's name).
  DECIDED_FOR
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  image       String?
  googleSub   String?   @unique @map("google_sub")
  department  String?
  phone       String?
  role        Role      @default(EMPLOYEE)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Sign-in with an email and a password, next to Google. No hash means the person has no password yet.
  passwordHash       String?   @map("password_hash")
  // Set when an administrator gave a temporary password: the person must choose their own before anything else.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  // Sessions opened before this moment are no longer valid.
  passwordChangedAt  DateTime? @map("password_changed_at")
  // Wrong passwords in a row, and when the lock after too many of them ends.
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")

  requests         ServiceRequest[] @relation("Requester")
  assignedRequests ServiceRequest[] @relation("Assignee")
  decidedRequests  ServiceRequest[] @relation("Decider")
  approvalRequests ServiceRequest[] @relation("Approver")
  deletedRequests  ServiceRequest[] @relation("Deleter")
  comments         RequestComment[]
  events           RequestEvent[]
  articles         KbArticle[]
  auditLogs        AuditLog[]

  delegationsGiven    ApprovalDelegation[] @relation("DelegationManager")
  delegationsReceived ApprovalDelegation[] @relation("DelegationStandIn")

  @@index([role, isActive])
  @@map("tbl_users")
}

// A manager who is away names another manager to approve in their place for a period of time.
model ApprovalDelegation {
  id         String    @id @default(cuid())
  managerId  String    @map("manager_id")
  delegateId String    @map("delegate_id")
  startsAt   DateTime  @map("starts_at")
  endsAt     DateTime  @map("ends_at")
  // Ended early by hand; the row is kept so the history shows who stood in when.
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  manager  User @relation("DelegationManager", fields: [managerId], references: [id], onDelete: Cascade)
  delegate User @relation("DelegationStandIn", fields: [delegateId], references: [id], onDelete: Cascade)

  @@index([managerId, endsAt])
  @@index([delegateId, endsAt])
  @@map("tbl_approval_delegations")
}

model ServiceRequest {
  id          String        @id @default(cuid())
  requestNo   String        @unique @map("request_no")
  type        RequestType
  title       String
  description String        @db.Text
  priority    Priority      @default(MEDIUM)
  status      RequestStatus @default(SUBMITTED)
  // Type-specific fields (see src/lib/request-types.ts)
  details     Json          @default("{}")
  neededBy    DateTime?     @map("needed_by")

  // When the request is for someone else (e.g. a new hire): their name and department
  requestedForName String? @map("requested_for_name")

  requesterId       String    @map("requester_id")
  assigneeId        String?   @map("assignee_id")
  // The manager who must approve before the request reaches the IT queue (only for some request types)
  approverId        String?   @map("approver_id")
  managerApprovedAt DateTime? @map("manager_approved_at")
  decidedById       String?   @map("decided_by_id")
  decidedAt         DateTime? @map("decided_at")
  // While waiting for approval: when the approver asked the requester for more information (cleared by the answer),
  // and when the requester last answered. The approver's waiting time counts from the answer.
  infoRequestedAt   DateTime? @map("info_requested_at")
  infoAnsweredAt    DateTime? @map("info_answered_at")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  // Soft delete: a deleted request is hidden everywhere except in system management, where it can be restored.
  deletedAt         DateTime? @map("deleted_at")
  deletedById       String?   @map("deleted_by_id")

  // SLA. Due dates are null for requests created before SLA tracking.
  slaTier          SlaTier   @default(PROVISIONING) @map("sla_tier")
  firstResponseAt  DateTime? @map("first_response_at")
  responseDueAt    DateTime? @map("response_due_at")
  fulfillmentDueAt DateTime? @map("fulfillment_due_at")
  // Set while the clock is stopped (waiting for approval, requester or vendor)
  slaPausedAt      DateTime? @map("sla_paused_at")
  slaPausedMinutes Int       @default(0) @map("sla_paused_minutes")

  requester User  @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  approver  User? @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)
  decidedBy User? @relation("Decider", fields: [decidedById], references: [id], onDelete: SetNull)
  deletedBy User? @relation("Deleter", fields: [deletedById], references: [id], onDelete: Restrict)

  comments RequestComment[]
  events   RequestEvent[]

  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([status, fulfillmentDueAt])
  @@index([requesterId, createdAt])
  @@index([assigneeId, status])
  @@index([approverId, status])
  @@index([type])
  @@map("tbl_service_requests")
}

model RequestComment {
  id         String   @id @default(cuid())
  requestId  String   @map("request_id")
  authorId   String   @map("author_id")
  body       String   @db.Text
  // Internal notes are visible to IT staff / admin only
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("tbl_request_comments")
}

model RequestEvent {
  id        String      @id @default(cuid())
  requestId String      @map("request_id")
  actorId   String      @map("actor_id")
  action    EventAction
  fromValue String?     @map("from_value")
  toValue   String?     @map("to_value")
  createdAt DateTime    @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("tbl_request_events")
}

// Atomic sequence for request numbers, one row per year: key = "SR-2026"
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("tbl_counters")
}

// Who changed users and knowledge base articles (request changes live in RequestEvent).
// `summary` is a snapshot, because the entity may have been deleted since.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  summary   String
  createdAt DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("tbl_audit_logs")
}

// Knowledge base article written by the IT team, searchable from the portal home page.
model KbArticle {
  id          String   @id @default(cuid())
  title       String
  category    String
  // One or two sentences shown in search results
  summary     String
  // Simple markdown (headings, lists, bold, code), see src/lib/kb-markdown.ts
  body        String   @db.Text
  isPublished Boolean  @default(true) @map("is_published")
  authorId    String   @map("author_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([isPublished, category])
  @@index([updatedAt])
  @@map("tbl_kb_articles")
}
